[Unit]
Description=piHome kiosk (cage + Chromium)
After=systemd-user-sessions.service network-online.target time-sync.target getty@tty1.service
Wants=network-online.target
Conflicts=getty@tty1.service

[Service]
Type=simple
User=mirion
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=XDG_SESSION_TYPE=wayland
# wlroots refuses to start with zero input devices - this Pi has no keyboard/mouse.
Environment=WLR_LIBINPUT_NO_DEVICES=1
ExecStart=/usr/bin/cage -d -- /usr/local/bin/pihome-kiosk.sh
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
